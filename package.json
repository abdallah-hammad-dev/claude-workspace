{
  "name": "claude-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian as a workspace for Claude Code: live context, local MCP server, modules.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:mobile": "node scripts/check-mobile-load.cjs main.js"
  },
  "author": "Abdallah Hammad",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^22.20.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
